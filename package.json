{
  "name": "btt-web-game-jam-summer-2026",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "build": "npm run check:local-state && npm run check:boundaries && tsc -b && vite build",
    "check": "npm run check:local-state && npm run format:check && npm run lint && npm run typecheck && npm run check:boundaries",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:local-state": "node scripts/check-local-state.mjs",
    "clean": "npm run check:local-state && node scripts/clean.mjs",
    "dev:preflight": "node scripts/dev-services.mjs preflight",
    "dev:up": "node scripts/dev-services.mjs up",
    "dev:health": "node scripts/dev-services.mjs health",
    "dev:down": "node scripts/dev-services.mjs down",
    "format": "npm run format:check",
    "format:check": "prettier --check .",
    "format:write": "npm run check:local-state && npm run check:boundaries && prettier --write .",
    "full-verify": "npm run verify-all",
    "lint": "eslint . --max-warnings 0",
    "playwright:install": "node scripts/playwright-runner.mjs install chromium firefox webkit",
    "playwright:install-deps": "node scripts/playwright-runner.mjs install-deps chromium firefox webkit",
    "release-check": "npm run verify-all",
    "run-local": "npm run dev:up",
    "security:audit": "npm audit --audit-level=high",
    "test": "npm run check:local-state && npm run test:unit && npm run test:tooling",
    "test:unit": "npm run check:local-state && vitest run --coverage && node scripts/check-coverage.mjs",
    "test:tooling": "npm run check:local-state && node --test tests/tooling/*.test.mjs",
    "test:integration": "node scripts/playwright-runner.mjs test --btt-target e2e --grep @integration",
    "test:e2e": "node scripts/playwright-runner.mjs test --btt-target e2e",
    "test:e2e:preview": "node scripts/playwright-target.mjs preview",
    "test:e2e:static": "node scripts/playwright-target.mjs static",
    "typecheck": "npm run check:local-state && npm run check:boundaries && tsc -b",
    "verify-all": "node scripts/verify-all.mjs",
    "serve:game": "node scripts/vite-service.mjs game",
    "serve:preview": "node scripts/vite-service.mjs preview",
    "serve:e2e": "node scripts/vite-service.mjs e2e",
    "serve:static": "node scripts/static-server.mjs"
  },
  "dependencies": {
    "idb": "8.0.3",
    "pixi.js": "8.19.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "fast-check": "4.9.0",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
