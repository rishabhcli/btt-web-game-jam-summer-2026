{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./.dev/cache/typescript/domain.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": [],
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "./src",
    "outDir": "./.dev/cache/typescript/domain-types"
  },
  "include": [
    "src/build-status.ts",
    "src/domain/**/*.ts",
    "src/engine/**/*.ts",
    "src/ghosts/**/*.ts",
    "src/levels/**/*.ts",
    "src/history/domain/**/*.ts"
  ]
}
